# Database Connection String for PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/medrella_db?schema=public"

# Application Port
PORT=4000

# Authentication Secrets
JWT_ACCESS_SECRET="medrella_dev_access_secret_super_secure_key_change_in_production_2026"
REFRESH_TOKEN_SECRET="medrella_dev_refresh_secret_super_secure_key_change_in_production_2026"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
